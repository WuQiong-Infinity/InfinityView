<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Values mirror docs/design/v0.2/design-tokens.json. Canvas is independent. -->
  <SolidColorBrush x:Key="WindowBrush" Color="#171A20"/>
  <SolidColorBrush x:Key="ChromeBrush" Color="#20242B"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#252A33"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#303744"/>
  <SolidColorBrush x:Key="PressedBrush" Color="#151A22"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#39414E"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#313844"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F2F5F9"/>
  <SolidColorBrush x:Key="SecondaryBrush" Color="#AEB8C8"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#939EAF"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#88CFFF"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#233D52"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#83D1AF"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#E8C17E"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#FFAAA5"/>
  <SolidColorBrush x:Key="CanvasBrush" Color="#101010"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#233D52"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F2F5F9"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#303744"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F2F5F9"/>
</ResourceDictionary>
