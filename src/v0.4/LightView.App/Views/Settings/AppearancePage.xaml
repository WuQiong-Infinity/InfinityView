<UserControl x:Class="LightView.App.Views.Settings.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LightView.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="外观与显示" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="只预览外观。应用成功后保存；关闭放弃尚未应用的更改。" Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
      <WrapPanel>
        <StackPanel Width="340" Margin="0,0,24,24">
          <TextBlock Text="画布" FontSize="16" Margin="0,0,0,8"/>
          <ComboBox x:Name="CanvasChoice" SelectedIndex="0" SelectionChanged="OnChanged" AutomationProperties.Name="画布背景">
            <ComboBoxItem Content="深灰" Tag="darkGray"/><ComboBoxItem Content="中灰" Tag="midGray"/><ComboBoxItem Content="黑色" Tag="black"/>
          </ComboBox>
          <CheckBox x:Name="CheckerChoice" Content="透明图片棋盘格" Checked="OnChanged" Unchecked="OnChanged" Margin="0,8,0,0"/>
          <TextBlock Text="图片详情" FontSize="16" Margin="0,16,0,8"/>
          <DockPanel><TextBlock Text="字号"/><TextBlock x:Name="FontReadout" HorizontalAlignment="Right"/></DockPanel>
          <Slider x:Name="FontSlider" Minimum="12" Maximum="24" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnChanged" AutomationProperties.Name="详情字号"/>
          <DockPanel><TextBlock Text="黑色描边"/><TextBlock x:Name="OutlineReadout" HorizontalAlignment="Right"/></DockPanel>
          <Slider x:Name="OutlineSlider" Minimum="0" Maximum="3" Value="1.2" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="OnChanged" AutomationProperties.Name="详情描边粗细"/>
          <DockPanel><TextBlock Text="行间距"/><TextBlock x:Name="GapReadout" HorizontalAlignment="Right"/></DockPanel>
          <Slider x:Name="GapSlider" Minimum="0" Maximum="12" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnChanged" AutomationProperties.Name="详情行间距"/>
          <DockPanel><TextBlock Text="详情宽度"/><TextBlock x:Name="WidthReadout" HorizontalAlignment="Right"/></DockPanel>
          <Slider x:Name="WidthSlider" Minimum="320" Maximum="600" Value="440" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnChanged" AutomationProperties.Name="详情宽度"/>
          <CheckBox x:Name="FitChoice" Content="适应小窗口" IsChecked="True" Checked="OnChanged" Unchecked="OnChanged"/>
          <TextBlock Text="关闭后保持固定字号，超出区域会裁切；放大窗口可查看全部。" Style="{StaticResource SecondaryText}"/>
          <CheckBox x:Name="MotionChoice" Content="减少界面动效" Checked="OnChanged" Unchecked="OnChanged" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Width="320" Margin="0,0,0,24">
          <TextBlock Text="效果预览" FontSize="16" Margin="0,0,0,8"/>
          <Border x:Name="PreviewBackground" Height="272" Background="#808080" CornerRadius="8" ClipToBounds="True" Padding="12">
            <Viewbox x:Name="PreviewFit" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Left">
              <StackPanel x:Name="PreviewText" Width="424" IsHitTestVisible="False">
                <local:OutlinedTextBlock x:Name="PreviewTitle" Text="图片详情" FontSize="22" Foreground="White"/>
                <local:OutlinedTextBlock x:Name="PreviewSection" Text="人工预览样本" FontSize="17" Foreground="White" Margin="0,10,0,6"/>
                <local:OutlinedTextBlock x:Name="PreviewName" Text="文件名    人工样本.png" FontSize="16" Foreground="White" TextWrapping="Wrap"/>
                <local:OutlinedTextBlock x:Name="PreviewPixels" Text="像素尺寸    6,000 × 4,000" FontSize="16" Foreground="White" TextWrapping="Wrap"/>
                <local:OutlinedTextBlock x:Name="PreviewFocal" Text="焦距    35mm（等效52mm）" FontSize="16" Foreground="White" TextWrapping="Wrap"/>
              </StackPanel>
            </Viewbox>
          </Border>
          <WrapPanel Margin="0,8,0,0"><Button Content="人工样本" Tag="sample" Click="OnPreviewBackground"/><Button Content="白底" Tag="white" Click="OnPreviewBackground"/><Button Content="黑底" Tag="black" Click="OnPreviewBackground"/></WrapPanel>
          <TextBlock Text="示例文字和图形只用于选择字号与描边，不作照片或色彩验收。详情在主画布上仍可鼠标穿透。" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
        </StackPanel>
      </WrapPanel>
      <StackPanel Margin="0,0,0,16"><Button x:Name="DetailsLink" Content="配置图片详情…" Click="OnOpenDetails" HorizontalAlignment="Left"/><TextBlock Text="在图片详情页直接勾选、拖动排序并查看实时预览。" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
