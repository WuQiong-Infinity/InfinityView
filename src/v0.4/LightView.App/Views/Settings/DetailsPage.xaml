<UserControl x:Class="LightView.App.Views.Settings.DetailsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LightView.App.Views">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="图片详情" Style="{StaticResource PageTitle}"/><TextBlock Text="直接勾选 · 拖动排序 · 同步预览" Style="{StaticResource SecondaryText}"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" MinWidth="320"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
    <StackPanel><StackPanel x:Name="CardsHost"/><WrapPanel Margin="0,4,0,8"><Button x:Name="ResetLayoutButton" Content="恢复详情默认" Click="OnReset"/><TextBlock Text="异常提示始终保留" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel></StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="实时预览" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="人工样本，仅预览文字布局" Style="{StaticResource SecondaryText}" Margin="0,5,0,12"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><ToggleButton x:Name="LeftPreviewButton" Content="左侧排列" Click="OnPreviewSide" Tag="left" Padding="12,6"/><ToggleButton x:Name="RightPreviewButton" Content="右侧排列" Click="OnPreviewSide" Tag="right" Padding="12,6" Margin="8,0,0,0" IsChecked="True"/></StackPanel>
    <Border Grid.Row="2" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" ClipToBounds="True">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Viewbox x:Name="PreviewScale" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"><local:DetailsContentView x:Name="PreviewDisplay" Width="424"/></Viewbox></ScrollViewer>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
