<Window x:Class="LightView.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LightView.App.Views"
        Title="{Binding WindowTitle}" Width="1120" Height="760"
        MinWidth="640" MinHeight="420" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="/InfinityView;component/Assets/InfinityView.ico" FontFamily="{StaticResource UiFont}" FontSize="14"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewMouseUp="OnPreviewMouseUp"
        PreviewMouseWheel="OnPreviewMouseWheel"
        PreviewMouseMove="OnPreviewMouseMove"
        Loaded="OnLoaded" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </Window.Resources>
  <Grid x:Name="RootLayout">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TopChromeRow" Height="44"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border x:Name="TopBar" Grid.RowSpan="2" Panel.ZIndex="30" VerticalAlignment="Top" Background="{DynamicResource ChromeBrush}" Height="44">
      <Grid Margin="8,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="OpenButton" Click="OnOpenClick" Padding="10,0" Margin="0,0,8,0" AutomationProperties.Name="打开图片">
            <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource CommandGlyph}" Content="{StaticResource OpenIcon}"/><TextBlock Text="打开" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Click="OnPreviousClick" IsEnabled="{Binding CanNavigate}" AutomationProperties.Name="上一张"><ContentControl Style="{StaticResource CommandGlyph}" Content="{StaticResource PreviousIcon}"/></Button>
          <Button x:Name="NextButton" Style="{StaticResource IconButton}" Click="OnNextClick" IsEnabled="{Binding CanNavigate}" AutomationProperties.Name="下一张"><ContentControl Style="{StaticResource CommandGlyph}" Content="{StaticResource NextIcon}"/></Button>
          <TextBlock x:Name="PositionReadout" Text="{Binding ImagePosition}" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="12,0,16,0" MinWidth="44"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
          <ToggleButton x:Name="FitButton" Style="{StaticResource IconToggleButton}" Click="OnFitClick" AutomationProperties.Name="适配窗口"><ContentControl Style="{StaticResource CommandGlyph}" Content="{StaticResource FitIcon}"/></ToggleButton>
          <ToggleButton x:Name="ActualPixelsButton" Style="{StaticResource IconToggleButton}" Width="52" Content="100%" Click="OnActualPixelsClick" AutomationProperties.Name="100%居中显示"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <StackPanel x:Name="SecondaryCommands" Orientation="Horizontal">
            <ToggleButton x:Name="DetailsButton" Style="{StaticResource IconToggleButton}" Click="OnDetailsClick" AutomationProperties.Name="图片详情"><ContentControl Style="{StaticResource CommandGlyph}" Content="{StaticResource DetailsIcon}"/></ToggleButton>
            <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="OnUndoClick" IsEnabled="False" AutomationProperties.Name="撤销本次会话操作"><ContentControl Style="{StaticResource CommandGlyph}" Content="{StaticResource UndoIcon}"/></Button>
            <ToggleButton x:Name="FullScreenButton" Style="{StaticResource IconToggleButton}" Click="OnFullScreenClick" AutomationProperties.Name="全屏"><ContentControl Style="{StaticResource CommandGlyph}" Content="{StaticResource FullScreenIcon}"/></ToggleButton>
            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="OnSettingsClick" AutomationProperties.Name="设置"><ContentControl Style="{StaticResource CommandGlyph}" Content="{StaticResource SettingsIcon}"/></Button>
          </StackPanel>
          <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Click="OnMoreClick" ToolTip="更多操作" AutomationProperties.Name="更多操作">
            <Button.ContextMenu><ContextMenu x:Name="MoreMenu" Opened="OnMoreOpened" Closed="OnMoreClosed">
              <MenuItem x:Name="FitMenuItem" Header="适配窗口" Tag="view.fit" Click="OnMenuCommand"/>
              <MenuItem x:Name="ActualMenuItem" Header="100% 居中显示" Tag="view.actualPixels" Click="OnMenuCommand"/>
              <MenuItem x:Name="DetailsMenuItem" Header="图片详情" Tag="image.details" IsCheckable="True" Click="OnMenuCommand"/>
              <MenuItem x:Name="ComparisonMenuItem" Header="进入图片对比" Tag="compare.toggle" Click="OnMenuCommand"/>
              <MenuItem x:Name="LinkComparisonMenuItem" Header="联动缩放与位置" IsCheckable="True" Tag="compare.link" Click="OnMenuCommand"/>
              <MenuItem x:Name="HistogramMenuItem" Header="直方图" IsCheckable="True" Tag="image.histogram" Click="OnMenuCommand"/>
              <MenuItem x:Name="CopyShootingMenuItem" Header="复制拍摄信息" Tag="image.copyShootingInfo" Click="OnMenuCommand"/>
              <MenuItem x:Name="UndoMenuItem" Header="撤销本次会话操作" Tag="organizing.undo" Click="OnMenuCommand"/>
              <MenuItem x:Name="FullScreenMenuItem" Header="全屏" Tag="view.fullScreen" IsCheckable="True" Click="OnMenuCommand"/>
              <MenuItem Header="设置" Tag="settings.open" Click="OnMenuCommand"/>
              <Separator/>
              <MenuItem Header="恢复记录" Tag="organizing.recovery" Click="OnMenuCommand"/>
              <MenuItem x:Name="RevealMenuItem" Header="在资源管理器中显示" Tag="image.reveal" Click="OnMenuCommand"/>
              <MenuItem Header="关于 InfinityView" Tag="app.about" Click="OnMenuCommand"/>
            </ContextMenu></Button.ContextMenu>
            <ContentControl Style="{StaticResource CommandGlyph}" Content="{StaticResource MoreIcon}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="ComparisonGrid" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ReferenceColumn" Width="0"/><ColumnDefinition x:Name="ComparisonSeparatorColumn" Width="0"/><ColumnDefinition x:Name="CurrentColumn" Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="ReferencePane" Grid.Column="0" Background="{DynamicResource CanvasBrush}" ClipToBounds="True" Visibility="Collapsed">
        <local:HistogramView x:Name="LeftHistogram" Panel.ZIndex="26" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,10,10,0"/>
        <local:PaneFocusCorners x:Name="LeftFocusCorners" Panel.ZIndex="25"/>
        <local:ImageViewport x:Name="ReferenceViewport" Image="{Binding DisplayedImage}" AutomationProperties.Name="左图片画布"/>
        <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="InfinityView" FontSize="34" HorizontalAlignment="Center"/><TextBlock Text="双击空白处或拖入一张图片" Foreground="#B0B0B0" Margin="0,14,0,0"/>
        </StackPanel>
        <local:OutlinedTextBlock x:Name="ReferenceName" Text="{Binding FileName}" Visibility="Collapsed" FontSize="12" Foreground="#A0A0A0" OutlineThickness=".7" TextTrimming="CharacterEllipsis" TextAlignment="Right" IsHitTestVisible="False" ClipToBounds="True" Margin="10,0,10,10" VerticalAlignment="Bottom"/>
        <TextBlock IsHitTestVisible="False" Text="快速预览，原图未就绪" Foreground="#B0B0B0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12" Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock IsHitTestVisible="False" Text="文件已变化，请重新打开后再整理" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,0,12,32" TextWrapping="Wrap" Visibility="{Binding IsDisplayedInvalid, Converter={StaticResource BoolToVisibility}}"/>
        <Border IsHitTestVisible="False" Background="#CC222222" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,32,12,0" Padding="14,8" Visibility="{Binding ShowLoadingIndicator, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="正在读取图片…"/></Border>
        <Border x:Name="LeftOperationToast" Panel.ZIndex="20" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" MaxWidth="680" Padding="20,12" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource SuccessBrush}">
          <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="×" Click="OnDismissFeedback" AutomationProperties.Name="关闭操作提示"/><TextBlock x:Name="LeftOperationToastText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/></DockPanel>
        </Border>
        <TextBlock x:Name="LeftComparisonError" Visibility="Collapsed" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Background="{DynamicResource ChromeBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="12"/>
      <Border x:Name="LeftDetailsPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="440" Margin="10,10,10,10" Background="Transparent" IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
        <Viewbox x:Name="LeftDetailsViewbox" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"><local:DetailsContentView Width="{DynamicResource DetailsContentWidth}" Sections="{Binding DetailsSections}"/></Viewbox>
      </Border>
        <Border x:Name="ReferencePlaceholder" Background="{DynamicResource CanvasBrush}" Visibility="Collapsed"><TextBlock x:Name="ReferencePlaceholderText" Text="正在更新图片色彩…" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
      <GridSplitter x:Name="PaneSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>
      <Grid x:Name="CanvasContainer" Grid.Column="2" Background="{DynamicResource CanvasBrush}" ClipToBounds="True" Visibility="Visible">
        <local:HistogramView x:Name="RightHistogram" Panel.ZIndex="26" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,10,10,0"/>
        <local:PaneFocusCorners x:Name="RightFocusCorners" Panel.ZIndex="25"/>
        <local:ImageViewport x:Name="Viewport" Image="{Binding DisplayedImage}" AutomationProperties.Name="图片画布"/>
        <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="InfinityView" FontSize="34" HorizontalAlignment="Center"/><TextBlock Text="双击空白处或拖入一张图片" Foreground="#B0B0B0" Margin="0,14,0,0"/>
        </StackPanel>
        <local:OutlinedTextBlock x:Name="CurrentComparisonName" Text="{Binding FileName}" Visibility="Collapsed" FontSize="12" Foreground="#A0A0A0" OutlineThickness=".7" TextTrimming="CharacterEllipsis" TextAlignment="Left" IsHitTestVisible="False" ClipToBounds="True" Margin="10,0,10,10" VerticalAlignment="Bottom"/>
        <TextBlock IsHitTestVisible="False" Text="快速预览，原图未就绪" Foreground="#B0B0B0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12" Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock IsHitTestVisible="False" Text="文件已变化，请重新打开后再整理" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,0,12,32" TextWrapping="Wrap" Visibility="{Binding IsDisplayedInvalid, Converter={StaticResource BoolToVisibility}}"/>
        <Border IsHitTestVisible="False" Background="#CC222222" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,32,12,0" Padding="14,8" Visibility="{Binding ShowLoadingIndicator, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="正在读取图片…"/></Border>
        <Border x:Name="OperationToast" Panel.ZIndex="20" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" MaxWidth="680" Padding="20,12" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource SuccessBrush}">
          <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="×" Click="OnDismissFeedback" AutomationProperties.Name="关闭操作提示"/><TextBlock x:Name="OperationToastText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/></DockPanel>
        </Border>
        <TextBlock x:Name="ComparisonError" Visibility="Collapsed" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Background="{DynamicResource ChromeBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="12"/>
      <Border x:Name="DetailsPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="440" Margin="10,10,10,10" Background="Transparent" IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
        <Viewbox x:Name="DetailsViewbox" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"><local:DetailsContentView Width="{DynamicResource DetailsContentWidth}" Sections="{Binding DetailsSections}"/></Viewbox>
      </Border>
        <Border x:Name="CurrentColorPlaceholder" Background="{DynamicResource CanvasBrush}" Visibility="Collapsed"><TextBlock x:Name="CurrentColorPlaceholderText" Text="正在更新图片色彩…" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
    </Grid>
    <Border x:Name="LinkToast" Grid.Row="1" Panel.ZIndex="40" Visibility="Collapsed" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,16,12,0" Padding="16,8" CornerRadius="5"
            Background="{DynamicResource SurfaceBrush}">
      <TextBlock x:Name="LinkToastText" Foreground="{DynamicResource TextBrush}"/>
    </Border>
    <StackPanel x:Name="NoticePanel" Grid.Row="2" Margin="18,8">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                 TextWrapping="Wrap" AutomationProperties.Name="读取错误"/>
    </StackPanel>
    <DockPanel x:Name="Footer" Grid.Row="3" Background="{DynamicResource ChromeBrush}" LastChildFill="True" Height="28">
      <TextBlock Text="{Binding ActivityStatus}" DockPanel.Dock="Right"
                 Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding ImageSummary}" Margin="12,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="ZoomReadout" Text="适配" Margin="12,0" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
