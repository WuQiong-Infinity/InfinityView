<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AssemblyName>InfinityView</AssemblyName>
    <BaseOutputPath>bin/InfinityView/</BaseOutputPath>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>InfinityView</Product>
    <Title>InfinityView</Title>
    <Company>InfinityView</Company>
    <Description>InfinityView 图片查看与安全整理</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/InfinityView.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/InfinityView.ico" />
    <Resource Include="Assets/InfinityView-48.png" />
    <ProjectReference Include="../LightView.Core/LightView.Core.csproj" />
    <Compile Include="../Compatibility/CompilerSupport.cs" Link="Compatibility/CompilerSupport.cs" />
    <Using Include="LightView.Compatibility" />
    <Content Include="runtimes/win-x64/native/lcms2.dll" Link="lcms2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="runtimes/win-x64/native/ivwebp.dll" Link="ivwebp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../native/lcms2/LICENSE" Link="licenses/LittleCMS-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>LightView.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
